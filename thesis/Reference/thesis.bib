@article{10.1007/s10618-024-01087-y,
    author = {Hill, Alessandro and Goo, Kalen and Agarwal, Puneet},
    title = {Recommending the right academic programs: an interest mining approach using BERTopic: Recommending the right academic programs: an interest...},
    year = {2025},
    issue_date = {May 2025},
    publisher = {Kluwer Academic Publishers},
    address = {USA},
    volume = {39},
